{
  "name": "kill-port-safe",
  "version": "1.0.0",
  "description": "Kill the process on a port (3000, 8080, any). Zero-dependency drop-in replacement for kill-port: fast, exact port matching, shows what it killed, works on Windows, macOS, Linux and Docker.",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kill-port-safe": "cli.js",
    "kill-port": "cli.js"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "cli.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeRafay/kill-port-safe.git"
  },
  "bugs": "https://github.com/CodeRafay/kill-port-safe/issues",
  "homepage": "https://github.com/CodeRafay/kill-port-safe#readme",
  "keywords": [
    "kill-port",
    "kill port",
    "port",
    "kill",
    "process",
    "eaddrinuse",
    "address already in use",
    "port in use",
    "free port",
    "port 3000",
    "lsof",
    "netstat",
    "cli",
    "cross-platform"
  ]
}
